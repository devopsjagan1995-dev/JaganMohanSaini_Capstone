# Copy this file to .env if you want to override defaults.
# The system runs with no API key. Leave USE_LLM=false for the unattended check.

OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=tfidf-local
USE_LLM=false

CHROMA_PATH=./storage/index
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.45
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.08
