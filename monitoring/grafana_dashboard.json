{
  "title": "CloudServe support router",
  "uid": "cloudserve-support",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Tickets processed",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(tickets_processed_total)"}]
    },
    {
      "type": "stat",
      "title": "Guardrail blocks",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(guardrail_blocks_total)"}]
    },
    {
      "type": "timeseries",
      "title": "Tickets by channel and outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (channel, outcome) (rate(tickets_processed_total[5m]))"}]
    },
    {
      "type": "timeseries",
      "title": "Response latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(response_seconds_bucket[5m])))"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(response_seconds_bucket[5m])))"}
      ]
    }
  ]
}
